{
    "name": "aazsamir/stasphp",
    "description": "PHP SDK for writing StashApp plugins and scrapers",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "stashapp",
        "sdk",
        "plugin",
        "scraper"
    ],
    "autoload": {
        "psr-4": {
            "Aazsamir\\Stasphp\\": "src/",
            "Stasphp\\Scrapers\\": ["scrapers/src/", "scrapers/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aazsamir\\Stasphp\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "aazsamir",
            "email": "sutikkukun@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/var-dumper": "^8.1"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "find src tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
